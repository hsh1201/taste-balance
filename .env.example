# 서비스의 공개 주소입니다. 공유 링크와 OG 태그가 이 값으로 만들어집니다.
# Vercel에서는 비워 두면 운영 주소를 자동으로 씁니다.
BASE_URL=http://127.0.0.1:8000

# 데이터베이스 접속 문자열입니다. 상대 경로는 프로젝트 루트를 기준으로 합니다.
# Vercel에서는 SQLite를 쓸 수 없어 Postgres 주소가 필요합니다. (deploy/VERCEL.md 참고)
DATABASE_URL=sqlite:///./taste_balance.db

# 서명용 비밀 키입니다. 32자 이상이어야 하며, 아래 명령으로 만들 수 있습니다.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 결과 페이지의 AI 선물 코멘트에 쓰는 Anthropic API 키입니다. 비워 두면 그 섹션만 나타나지 않습니다.
LLM_API_KEY=

# 코멘트를 쓸 모델입니다. 값이 없으면 claude-haiku-5-5를 씁니다.
LLM_MODEL=claude-haiku-5-5

# Vercel Cron이 만료 데이터를 정리할 때 쓰는 비밀 값입니다. 비워 두면 정리 경로가 열리지 않습니다.
CRON_SECRET=
